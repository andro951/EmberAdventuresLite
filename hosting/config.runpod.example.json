{
  "text": {
    "kind": "runpod-vllm",
    "baseUrl": "https://api.runpod.ai/v2/YOUR_TEXT_ENDPOINT_ID",
    "authorizationEnv": "RUNPOD_AUTHORIZATION",
    "model": "ember-qwen-27b",
    "maxTokens": 800,
    "temperature": 0.7,
    "pollIntervalMs": 1500,
    "topP": 0.8,
    "topK": 20,
    "enableThinking": false
  },
  "image": {
    "kind": "runpod-sglang-images",
    "baseUrl": "https://api.runpod.ai/v2/YOUR_IMAGE_ENDPOINT_ID",
    "authorizationEnv": "RUNPOD_AUTHORIZATION",
    "model": "krea/Krea-2-Turbo",
    "steps": 8,
    "guidanceScale": 1.0,
    "pollIntervalMs": 1500
  }
}
